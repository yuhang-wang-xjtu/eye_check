[Unit]
Description=Back up EyeBreak shared-session database
After=eyebreak-sync.service

[Service]
Type=oneshot
User=eyebreak
Group=eyebreak
ExecStart=/usr/bin/python3 /opt/eyebreak/backup.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/eyebreak
