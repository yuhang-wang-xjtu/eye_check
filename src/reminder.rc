#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
#include "typography.h"
IDI_APP ICON "app.ico"
201 WAVE "reminder.wav"

IDD_SETTINGS DIALOGEX 0, 0, 289, 308
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "提醒设置"
FONT UI_BODY_POINTS, UI_FONT_FACE
BEGIN
    CONTROL "播放提醒声音", IDC_SOUND_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 10, 110, 12
    EDITTEXT IDC_SOUND_PATH, 12, 27, 265, 19, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON "选择 WAV 文件…", IDC_BROWSE_SOUND, 12, 51, 95, 19
    PUSHBUTTON "恢复默认", IDC_DEFAULT_SOUND, 116, 51, 72, 19
    PUSHBUTTON "试听", IDC_PREVIEW_SOUND, 196, 51, 81, 19
    CONTROL "久坐提醒", IDC_SITTING_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 85, 89, 12
    EDITTEXT IDC_SITTING_MINUTES, 128, 82, 44, 19, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "分钟（1–480）", -1, 182, 86, 95, 12
    CONTROL "连续工作过长提醒", IDC_WORK_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 112, 110, 12
    EDITTEXT IDC_WORK_MINUTES, 128, 109, 44, 19, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "分钟（1–720）", -1, 182, 113, 95, 12
    CONTROL "深夜提醒", IDC_NIGHT_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 139, 89, 12
    EDITTEXT IDC_NIGHT_HOUR, 128, 136, 36, 19, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT ":", -1, 167, 140, 8, 12
    EDITTEXT IDC_NIGHT_MINUTE, 179, 136, 36, 19, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "24 小时制", -1, 223, 140, 54, 12
    LTEXT "深夜时段截至 06:00，同一次运行中每晚提醒一次。", IDC_NIGHT_HELP, 12, 165, 265, 14
    LTEXT "护眼休息时长", -1, 12, 187, 107, 14
    EDITTEXT IDC_REST_SECONDS, 128, 184, 44, 19, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "秒（1–600）", -1, 182, 188, 95, 12
    CONTROL "显示桌面悬浮图标（可拖动）", IDC_DESKTOP_ICON, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 209, 212, 14
    CONTROL "浅色模式（保存后应用）", IDC_LIGHT_MODE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 227, 212, 14
    LTEXT "立即休息 / 继续工作：Ctrl + Alt + L", IDC_HOTKEY_HELP, 12, 245, 265, 14
    LTEXT "提醒按任意键关闭；关闭后再次操作才继续计时。", IDC_RETURN_HELP, 12, 264, 265, 14
    DEFPUSHBUTTON "保存", IDOK, 131, 282, 70, 20
    PUSHBUTTON "取消", IDCANCEL, 207, 282, 70, 20
END

IDD_HEALTH DIALOGEX 0, 0, 289, 186
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "健康提醒"
FONT UI_BODY_POINTS, UI_FONT_FACE
BEGIN
    LTEXT "", IDC_HEALTH_TEXT, 12, 12, 265, 104
    LTEXT "键盘 / 手柄按键、点击窗口外或关闭按钮均可关闭。\n仅关闭提醒，不跳过休息；主窗口保持原样。", IDC_HEALTH_HELP, 12, 119, 265, 30
    PUSHBUTTON "立即休息", IDC_IMMEDIATE_REST, 12, 158, 88, 20
    PUSHBUTTON "结束本轮工作", IDC_END_WORK, 105, 158, 88, 20
    DEFPUSHBUTTON "关闭", IDOK, 199, 158, 78, 20
END

IDD_SYNC DIALOGEX 0, 0, 310, 235
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "服务器同步"
FONT UI_BODY_POINTS, UI_FONT_FACE
BEGIN
    LTEXT "服务器地址（HTTPS，可包含路径）", -1, 12, 10, 286, 13
    EDITTEXT IDC_SYNC_URL, 12, 26, 286, 20, ES_AUTOHSCROLL
    LTEXT "共享会话 ID（与安卓填写相同值）", -1, 12, 51, 286, 13
    EDITTEXT IDC_SYNC_ROOM, 12, 67, 286, 20, ES_AUTOHSCROLL
    LTEXT "访问令牌（留空保留已保存的令牌）", -1, 12, 92, 286, 13
    EDITTEXT IDC_SYNC_TOKEN, 12, 108, 286, 20, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "", IDC_SYNC_STATUS, 12, 135, 286, 28
    LTEXT "状态独立、倒计时相同；任一设备使用就倒数，全部休息才回补。", -1, 12, 166, 286, 26
    PUSHBUTTON "导入配置", IDC_SYNC_IMPORT, 12, 201, 65, 21
    PUSHBUTTON "连接并保存", IDC_SYNC_CONNECT, 82, 201, 74, 21
    PUSHBUTTON "切回本地", IDC_SYNC_LOCAL, 161, 201, 68, 21
    DEFPUSHBUTTON "关闭", IDCANCEL, 234, 201, 64, 21
END

#include "app_version.h"
1 VERSIONINFO
FILEVERSION EYEBREAK_VERSION_NUMBERS
PRODUCTVERSION EYEBREAK_VERSION_NUMBERS
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "20·20·20 护眼提醒\0"
            VALUE "FileVersion", EYEBREAK_VERSION_TEXT ".0\0"
            VALUE "ProductName", "EyeBreak\0"
            VALUE "ProductVersion", EYEBREAK_VERSION_TEXT "\0"
            VALUE "OriginalFilename", "EyeBreak.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END

IDD_UPDATE DIALOGEX 0, 0, 310, 145
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "检查更新"
FONT UI_BODY_POINTS, UI_FONT_FACE
BEGIN
    LTEXT "", IDC_UPDATE_STATUS, 12, 12, 286, 43
    LTEXT "点击更新后，后台下载并校验，自动替换原程序、重启；设置和记录保留。新版启动失败会恢复旧版。", -1, 12, 62, 286, 31
    DEFPUSHBUTTON "检查更新", IDC_UPDATE_ACTION, 12, 111, 95, 21
    PUSHBUTTON "GitHub 发布页", IDC_UPDATE_PAGE, 112, 111, 95, 21
    PUSHBUTTON "关闭", IDCANCEL, 212, 111, 86, 21
END

IDD_USAGE DIALOGEX 0, 0, 289, 220
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "每日使用统计"
FONT UI_BODY_POINTS, UI_FONT_FACE
BEGIN
    LTEXT "仅累计工作状态；暂停、休息、锁屏时停止。", IDC_USAGE_HELP, 12, 10, 265, 16
    LISTBOX IDC_USAGE_LIST, 12, 32, 265, 148, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "关闭", IDOK, 207, 190, 70, 20
END
